      ".read": "auth != null && auth.token.email == 'yzhsage@gmail.com'",
      ".write": "auth != null && auth.token.email == 'yzhsage@gmail.com'"
    },
    "attendanceJournal": {
      ".read": "auth != null && auth.token.email == 'yzhsage@gmail.com'",
      ".write": "auth != null && auth.token.email == 'yzhsage@gmail.com'"
    },
    "assessments": {
      ".read": "auth != null && auth.token.email == 'yzhsage@gmail.com'",
      ".write": "auth != null && auth.token.email == 'yzhsage@gmail.com'"
    },
    "fees": {
      ".read": "auth != null && auth.token.email == 'yzhsage@gmail.com'",
