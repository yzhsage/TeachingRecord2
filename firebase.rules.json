{
  "rules": {
    ".read": false,
    ".write": false,
    "students": {
      ".read": "auth != null && auth.token.email == 'yzhsage@gmail.com'",
      ".write": "auth != null && auth.token.email == 'yzhsage@gmail.com'"
    },
    "classes": {
      ".read": "auth != null && auth.token.email == 'yzhsage@gmail.com'",
      ".write": "auth != null && auth.token.email == 'yzhsage@gmail.com'"
    },
    "attendance": {
      ".read": "auth != null && auth.token.email == 'yzhsage@gmail.com'",
      ".write": "auth != null && auth.token.email == 'yzhsage@gmail.com'"
    },
    "attendanceJournal": {
      ".read": "auth != null && auth.token.email == 'yzhsage@gmail.com'",
      ".write": "auth != null && auth.token.email == 'yzhsage@gmail.com'"
    },
    "assessments": {
      ".read": "auth != null && auth.token.email == 'yzhsage@gmail.com'",
      ".write": "auth != null && auth.token.email == 'yzhsage@gmail.com'"
    },
    "fees": {
      ".read": "auth != null && auth.token.email == 'yzhsage@gmail.com'",
      ".write": "auth != null && auth.token.email == 'yzhsage@gmail.com'"
    },
    "calendarEvents": {
      ".read": "auth != null && auth.token.email == 'yzhsage@gmail.com'",
      ".write": "auth != null && auth.token.email == 'yzhsage@gmail.com'"
    },
    "meta": {
      ".read": "auth != null && auth.token.email == 'yzhsage@gmail.com'",
      ".write": "auth != null && auth.token.email == 'yzhsage@gmail.com'"
    },
    "records": {
      ".read": "auth != null && auth.token.email == 'yzhsage@gmail.com'",
      ".write": "auth != null && auth.token.email == 'yzhsage@gmail.com'"
    },
    "compatibility": {
      ".read": "auth != null && auth.token.email == 'yzhsage@gmail.com'",
      ".write": "auth != null && auth.token.email == 'yzhsage@gmail.com'"
    },
    "portalInvites": {
      "$code": {
        ".read": "auth != null && (auth.token.email == 'yzhsage@gmail.com' || (data.exists() && data.child('revoked').val() != true && (!data.child('claimedBy').exists() || data.child('claimedBy').val() == auth.uid)))",
        ".write": "auth != null && (auth.token.email == 'yzhsage@gmail.com' || (data.exists() && !data.child('claimedBy').exists() && data.child('revoked').val() != true && newData.child('claimedBy').val() == auth.uid && newData.child('studentId').val() == data.child('studentId').val() && newData.child('code').val() == data.child('code').val() && newData.child('role').val() == data.child('role').val() && newData.child('revoked').val() == data.child('revoked').val() && newData.child('createdAt').val() == data.child('createdAt').val()))"
      }
    },
    "portalAccounts": {
      ".read": "auth != null && auth.token.email == 'yzhsage@gmail.com'",
      ".write": "auth != null && auth.token.email == 'yzhsage@gmail.com'",
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || auth.token.email == 'yzhsage@gmail.com')",
        ".write": "auth != null && (auth.uid == $uid || auth.token.email == 'yzhsage@gmail.com')",
        "uid": {
          ".validate": "newData.val() == $uid"
        },
        "email": {
          ".validate": "newData.isString()"
        },
        "displayName": {
          ".validate": "newData.isString()"
        },
        "boundAt": {
          ".validate": "newData.isString()"
        },
        "studentIds": {
          "$studentId": {
            ".validate": "auth.token.email == 'yzhsage@gmail.com' || (newData.isString() && root.child('portalInvites').child(newData.val()).child('claimedBy').val() == $uid && root.child('portalInvites').child(newData.val()).child('studentId').val() == $studentId)"
          }
        },
        "$other": {
          ".validate": "false"
        }
      }
    },
    "portalStudentData": {
      ".write": "auth != null && auth.token.email == 'yzhsage@gmail.com'",
      "$studentId": {
        ".read": "auth != null && (auth.token.email == 'yzhsage@gmail.com' || (root.child('portalAccounts').child(auth.uid).child('studentIds').child($studentId).isString() && root.child('portalInvites').child(root.child('portalAccounts').child(auth.uid).child('studentIds').child($studentId).val()).child('claimedBy').val() == auth.uid && root.child('portalInvites').child(root.child('portalAccounts').child(auth.uid).child('studentIds').child($studentId).val()).child('revoked').val() != true))",
        ".write": "auth != null && auth.token.email == 'yzhsage@gmail.com'"
      }
    }
  }
}